// Version and copyright shown in the file's Properties in Windows Explorer (generated by CMake).
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Goshgar Hasanov"
            VALUE "FileDescription", "BootAz - bootable USB creator"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "Copyright (C) 2026 Goshgar Hasanov. Licensed under GPL-3.0."
            VALUE "ProductName", "BootAz"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
